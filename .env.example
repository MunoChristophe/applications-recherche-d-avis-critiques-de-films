# Clé API TMDB (The Movie Database)
# Crée un compte gratuit sur https://www.themoviedb.org/
# Puis va dans : Paramètres → API → Demander une clé API
# Copie ce fichier sous le nom ".env" et remplis ta clé ci-dessous.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
